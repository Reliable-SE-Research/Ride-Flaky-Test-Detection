CREATE TABLE `ad_campaign` (  `id` bigint(20) NOT NULL AUTO_INCREMENT,  `user_id` bigint(20) NOT NULL,  `name` varchar(128) NOT NULL,  `budget` mediumint(9) NOT NULL,  `state` smallint(6) NOT NULL,  `create_time` datetime NOT NULL,  `update_time` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,  PRIMARY KEY (`id`),  KEY `idx_user_id` (`user_id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='ad_campaign';
CREATE TABLE `date_table` (  `id` int(10) NOT NULL AUTO_INCREMENT,  `d1` datetime NOT NULL,  `d2` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,  `d3` datetime NOT NULL,  `d4` time NOT NULL,  `d5` date NOT NULL,  PRIMARY KEY (`id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='date_table';
CREATE TABLE `emps` (  `empid` bigint(20) NOT NULL,  `deptno` int(11) NOT NULL DEFAULT '0',  `name` varchar(10) NOT NULL,  `salary` decimal(6,2) NOT NULL,  `age` mediumint(9) NOT NULL,  `join_date` datetime NOT NULL,  PRIMARY KEY (`deptno`,`empid`,`name`)) ENGINE=InnoDB DEFAULT CHARSET=utf8;
CREATE TABLE `keyword` (  `id` bigint(20) NOT NULL,  `keyword` varchar(200) NOT NULL,  PRIMARY KEY (`id`),  KEY `idx_keyword` (`keyword`)) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='keyword';
CREATE TABLE `nullable_table` (  `id` int(10) NOT NULL AUTO_INCREMENT,  `int_value` int(11) DEFAULT NULL COMMENT '测试字段',  `long_value` bigint(20) DEFAULT NULL COMMENT '测试字段',  PRIMARY KEY (`id`)) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8 COMMENT='nullable_table';
CREATE TABLE `t` (  `id` int(11) NOT NULL,  `a` bigint(20) NOT NULL,  `b` varchar(64) NOT NULL,  PRIMARY KEY (`id`)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
CREATE TABLE `t1` (  `id` int(11) NOT NULL,  `a` int(11) DEFAULT NULL,  `b` int(11) DEFAULT NULL,  PRIMARY KEY (`id`),  KEY `a` (`a`),  KEY `b` (`b`)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
CREATE TABLE `t2` (  `id` int(11) NOT NULL,  `a` bigint(20) NOT NULL,  `b` varchar(64) NOT NULL,  PRIMARY KEY (`id`)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
CREATE TABLE `t3` (  `id` int(11) NOT NULL,  `a` int(11) NOT NULL,  PRIMARY KEY (`id`)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
